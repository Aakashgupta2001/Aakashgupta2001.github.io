---
import { person } from '../../content/portfolio';
const year = new Date().getFullYear();
---
<section id="contact" class="border-t hairline pt-24 md:pt-32">
  <div class="container-site">
    <p class="eyebrow" data-reveal>Contact</p>
    <h2 class="display mt-6 max-w-[18ch] text-[length:var(--text-display)]" data-reveal>
      Have a system that <em class="italic text-muted">has to work?</em>
    </h2>
    <div class="mt-14 flex flex-col gap-8 md:flex-row md:items-end md:justify-between" data-reveal>
      <a href={`mailto:${person.email}`} class="group inline-flex items-center gap-4 text-lg md:text-xl">
        <span class="border-b border-accent/40 pb-1 transition-colors group-hover:border-accent">{person.email}</span>
        <span class="text-accent transition-transform group-hover:translate-x-1">→</span>
      </a>
      <ul class="flex gap-8">
        {person.links.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener" class="font-mono text-xs uppercase tracking-[0.14em] text-muted transition-colors hover:text-ink">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <footer class="container-site mt-32 flex flex-col justify-between gap-3 border-t hairline py-8 font-mono text-[0.7rem] text-faint sm:flex-row">
    <p>© {year} {person.name}</p>
    <p>{person.city}, India · Built with Astro and WebGL</p>
  </footer>
</section>
