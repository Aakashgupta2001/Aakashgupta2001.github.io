---
// How I work: five plain principles, each one sentence. No clicking needed.
import { principles } from '../../content/portfolio';
---
<section id="approach" class="border-t hairline py-24 md:py-32">
  <div class="container-site grid gap-14 lg:grid-cols-[1fr_1.6fr]">
    <div data-reveal>
      <p class="eyebrow">Approach</p>
      <h2 class="display mt-4 text-[length:var(--text-h2)]">How I <em class="italic text-muted">work.</em></h2>
    </div>

    <ol class="border-t hairline" data-reveal>
      {principles.map((p, i) => (
        <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b hairline py-6">
          <span class="pt-1 font-mono text-xs text-faint">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-lg font-medium tracking-tight">{p.title}</h3>
            <p class="mt-1.5 max-w-[56ch] leading-relaxed text-muted">{p.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
