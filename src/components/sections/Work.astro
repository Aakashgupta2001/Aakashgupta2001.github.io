---
// Selected work in plain language. Each row is a title and one line; opening it tells the short story:
// what was wrong, what I did, what changed.
import { work } from '../../content/portfolio';
const steps = [
  { key: 'before', label: 'Before' },
  { key: 'did', label: 'What I did' },
  { key: 'after', label: 'What changed' },
] as const;
---
<section id="work" class="border-t hairline py-24 md:py-32">
  <div class="container-site">
    <div class="max-w-xl" data-reveal>
      <p class="eyebrow">Selected work</p>
      <h2 class="display mt-4 text-[length:var(--text-h2)]">Problems I’ve <em class="italic text-muted">made simple.</em></h2>
    </div>

    <div class="mt-14 border-t hairline" data-reveal>
      {work.map((w, i) => (
        <details class="row" id={`work-${w.id}`}>
          <summary class="grid-cols-[2.5rem_1fr_auto] md:grid-cols-[3rem_1fr_12rem_auto]">
            <span class="font-mono text-xs text-faint">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="row-title block text-lg font-medium tracking-tight md:text-xl">{w.title}</span>
              <span class="mt-1.5 block max-w-[60ch] text-sm leading-relaxed text-muted">{w.line}</span>
            </span>
            <span class="hidden text-right md:block">
              <span class="block text-lg font-medium tracking-tight">{w.outcome.value}</span>
              <span class="mt-0.5 block font-mono text-[0.62rem] leading-snug text-faint">{w.outcome.label}</span>
            </span>
            <span class="row-mark" aria-hidden="true"></span>
          </summary>

          <div class="row-body md:ml-[4rem]">
            <ol class="grid gap-8 md:grid-cols-3 md:gap-10">
              {steps.map((s) => (
                <li>
                  <p class="font-mono text-[0.66rem] uppercase tracking-[0.14em] text-faint">{s.label}</p>
                  <p class="mt-3 leading-relaxed text-ink/75">{w[s.key]}</p>
                </li>
              ))}
            </ol>
            <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[0.68rem] text-muted">
              <span class="md:hidden"><span class="text-ink/80">{w.outcome.value}</span> {w.outcome.label}</span>
              {w.status && <span class="flex items-center gap-2"><span class="inline-block h-1 w-1 rounded-full bg-accent"></span>{w.status}</span>}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
