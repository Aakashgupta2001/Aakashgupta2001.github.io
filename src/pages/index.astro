---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Work from '../components/sections/Work.astro';
import Approach from '../components/sections/Approach.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import { person } from '../content/portfolio';
---
<Base
  title={`${person.name} · ${person.role}`}
  description={`${person.line} ${person.intro}`}
>
  <Nav />
  <main id="main">
    <Hero />
    <Work />
    <Approach />
    <About />
    <Contact />
  </main>
</Base>
